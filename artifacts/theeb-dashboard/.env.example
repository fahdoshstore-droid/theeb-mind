# THEEB MIND dashboard — server-side environment only. Never put any of this in the HTML.
PORT=5173

# ── Live market data: TradingView MCP (primary) ─────────────────────
# Run/point to a TradingView MCP server. Use ONE of:
TRADINGVIEW_MCP_URL=                 # Streamable-HTTP endpoint, e.g. http://localhost:8000/mcp
TRADINGVIEW_MCP_COMMAND=             # or a stdio command, e.g. uvx
TRADINGVIEW_MCP_ARGS=                # JSON array, e.g. ["tradingview-mcp-server"]
# Optional mapping to your MCP server's OHLC tool:
# TRADINGVIEW_MCP_TOOL=get_ohlcv
# TRADINGVIEW_MCP_TOOL_ARGS={"symbol":"{symbol}","interval":"{interval}","bars":{count}}
# TRADINGVIEW_MCP_INTERVALS={"15m":"15","5m":"5","1d":"1D"}
# TRADINGVIEW_DATA_DELAYED=false     # true if your TradingView feed is delayed
# Symbols (EXCHANGE:TICKER)
# TV_SYMBOL_NQ=CME_MINI:NQ1!
# TV_SYMBOL_NAS100=OANDA:NAS100USD
# TV_SYMBOL_SPX=CME_MINI:ES1!
# TV_SYMBOL_VIX=TVC:VIX
# Any TradingView credentials your MCP server needs go here too (they are passed to the
# MCP process only, never to the browser).

# ── Optional AI chart reading (Market Analyst) ───────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
